{
  "name": "open-payment-adapter",
  "version": "0.2.0",
  "description": "Open payment provider port for SaaS billing (multi-PSP adapters)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "keywords": [
    "payment",
    "billing",
    "stripe",
    "paddle",
    "lemon-squeezy",
    "polar",
    "chargebee",
    "saas",
    "hexagonal"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asakaxgit/open-payment-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/asakaxgit/open-payment-adapter/issues"
  },
  "homepage": "https://github.com/asakaxgit/open-payment-adapter#readme",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "stripe": ">=14"
  },
  "peerDependenciesMeta": {
    "stripe": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@types/node": "^22.13.10",
    "stripe": "^22.6.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "author": "asakaxgit"
}
